		-rm -f ./$(DEPDIR)/libmod_test_resolver_la-mod_test_resolver.Plo
	-rm -f ./$(DEPDIR)/test_mod_resolver-test_mod_resolver.Po
	-rm -f ./$(DEPDIR)/test_resolver.Po
	-rm -f ./$(DEPDIR)/test_web_server_registry.Po
	-rm -f ./$(DEPDIR)/test_zmqsocket_timeouts.Po
	-rm -f Makefile
maintainer-clean-am: distclean-am maintainer-clean-generic

mostlyclean: mostlyclean-am

