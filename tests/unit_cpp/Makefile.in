AUTOMAKE_OPTIONS = foreign subdir-objects
AM_CFLAGS = $(SWITCH_AM_CFLAGS) $(SWITCH_ANSI_CFLAGS) $(CARES_CFLAGS)
AM_CPPFLAGS = $(SWITCH_AM_CXXFLAGS) $(CARES_CFLAGS)
AM_LDFLAGS = $(SWITCH_AM_LDFLAGS) -avoid-version -no-undefined \
	$(SWITCH_AM_LDFLAGS) $(openssl_LIBS) $(FREESWITCH_LIBS) \
	$(switch_builddir)/libfreeswitch.la $(CORE_LIBS) $(APR_LIBS) \
	$(CARES_LIBS) -lboost_system -lpthread
DEFAULT_VARS = CFLAGS="$(CFLAGS)" CPPFLAGS="$(CXXFLAGS)" LDFLAGS="$(LDFLAGS)" CC="$(CC)" CXX="$(CXX)"
DEFAULT_ARGS = --build=$(build) --host=$(host) --target=$(target) --prefix="$(prefix)" --exec_prefix="$(exec_prefix)" --libdir="$(libdir)" --disable-shared --with-pic
moddir = @modulesdir@
AM_CXXFLAGS = -std=c++17
test_zmqsocket_timeouts_SOURCES = test_zmqsocket_timeouts.cpp
test_zmqsocket_timeouts_LDADD = -lzmq -lstdc++
test_web_server_registry_SOURCES = test_web_server_registry.cpp

# Dummy FS module — convenience lib for linking into the test binary,
# and shared module for FST_MODULE_BEGIN to dlopen
@HAVE_CARES_TRUE@noinst_LTLIBRARIES = libmod_test_resolver.la
@HAVE_CARES_TRUE@libmod_test_resolver_la_SOURCES = mod_test_resolver.cpp
@HAVE_CARES_TRUE@libmod_test_resolver_la_CXXFLAGS = $(AM_CXXFLAGS)
@HAVE_CARES_TRUE@mod_LTLIBRARIES = mod_test_resolver.la
@HAVE_CARES_TRUE@mod_test_resolver_la_SOURCES = 
@HAVE_CARES_TRUE@mod_test_resolver_la_LIBADD = $(switch_builddir)/libfreeswitch.la libmod_test_resolver.la
@HAVE_CARES_TRUE@mod_test_resolver_la_LDFLAGS = -avoid-version -module -no-undefined -shared -lboost_system $(CARES_LIBS) -lstdc++

# Standalone C++ test (no FS core needed)
@HAVE_CARES_TRUE@test_resolver_SOURCES = test_resolver.cpp

# FST-based test that loads the module.
# SWITCH_TEST_BASE_DIR_OVERRIDE = abs_builddir/conf so that
# FST_MODULE_BEGIN looks in abs_builddir/conf/../.libs/ = abs_builddir/.libs/
@HAVE_CARES_TRUE@test_mod_resolver_SOURCES = test_mod_resolver.c
@HAVE_CARES_TRUE@test_mod_resolver_CFLAGS = $(AM_CFLAGS) -I$(srcdir) \
@HAVE_CARES_TRUE@	-DSWITCH_TEST_BASE_DIR_FOR_CONF=\"$(abs_builddir)/conf\" \
@HAVE_CARES_TRUE@	-DSWITCH_TEST_BASE_DIR_OVERRIDE=\"$(abs_builddir)/conf\"

@HAVE_CARES_TRUE@test_mod_resolver_LDADD = libmod_test_resolver.la -lstdc++
TESTS = $(noinst_PROGRAMS)
all: all-am

.SUFFIXES:
.SUFFIXES: .c .cpp .lo .log .o .obj .test .test$(EXEEXT) .trs
$(srcdir)/Makefile.in:  $(srcdir)/Makefile.am $(top_srcdir)/build/modmake.rulesam $(am__configure_deps)
	@for dep in $?; do \
	  case '$(am__configure_deps)' in \
	    *$$dep*) \
	      ( cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh ) \
	        && { if test -f $@; then exit 0; else break; fi; }; \
	      exit 1;; \
	  esac; \
	done; \
	echo ' cd $(top_srcdir) && $(AUTOMAKE) --foreign tests/unit_cpp/Makefile'; \
	$(am__cd) $(top_srcdir) && \
	  $(AUTOMAKE) --foreign tests/unit_cpp/Makefile
Makefile: $(srcdir)/Makefile.in $(top_builddir)/config.status
	@case '$?' in \
	  *config.status*) \
	    cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh;; \
	  *) \
	    echo ' cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__maybe_remake_depfiles)'; \
	    cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__maybe_remake_depfiles);; \
	esac;
$(top_srcdir)/build/modmake.rulesam $(am__empty):

$(top_builddir)/config.status: $(top_srcdir)/configure $(CONFIG_STATUS_DEPENDENCIES)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh

$(top_srcdir)/configure:  $(am__configure_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(ACLOCAL_M4):  $(am__aclocal_m4_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(am__aclocal_m4_deps):

clean-noinstPROGRAMS:
	@list='$(noinst_PROGRAMS)'; test -n "$$list" || exit 0; \
	echo " rm -f" $$list; \
	rm -f $$list || exit $$?; \
	test -n "$(EXEEXT)" || exit 0; \
	list=`for p in $$list; do echo "$$p"; done | sed 's/$(EXEEXT)$$//'`; \
	echo " rm -f" $$list; \
	rm -f $$list

install-modLTLIBRARIES: $(mod_LTLIBRARIES)
	@$(NORMAL_INSTALL)
	@list='$(mod_LTLIBRARIES)'; test -n "$(moddir)" || list=; \
	list2=; for p in $$list; do \
	  if test -f $$p; then \
	    list2="$$list2 $$p"; \
	  else :; fi; \
	done; \
	test -z "$$list2" || { \
	  echo " $(MKDIR_P) '$(DESTDIR)$(moddir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(moddir)" || exit 1; \
	  echo " $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL) $(INSTALL_STRIP_FLAG) $$list2 '$(DESTDIR)$(moddir)'"; \
	  $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL) $(INSTALL_STRIP_FLAG) $$list2 "$(DESTDIR)$(moddir)"; \
	}

uninstall-modLTLIBRARIES:
	@$(NORMAL_UNINSTALL)
	@list='$(mod_LTLIBRARIES)'; test -n "$(moddir)" || list=; \
	for p in $$list; do \
	  $(am__strip_dir) \
	  echo " $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=uninstall rm -f '$(DESTDIR)$(moddir)/$$f'"; \
	  $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=uninstall rm -f "$(DESTDIR)$(moddir)/$$f"; \
	done

clean-modLTLIBRARIES:
	-test -z "$(mod_LTLIBRARIES)" || rm -f $(mod_LTLIBRARIES)
	@list='$(mod_LTLIBRARIES)'; \
	locs=`for p in $$list; do echo $$p; done | \
	      sed 's|^[^/]*$$|.|; s|/[^/]*$$||; s|$$|/so_locations|' | \
	      sort -u`; \
	test -z "$$locs" || { \
	  echo rm -f $${locs}; \
	  rm -f $${locs}; \
	}

clean-noinstLTLIBRARIES:
	-test -z "$(noinst_LTLIBRARIES)" || rm -f $(noinst_LTLIBRARIES)
	@list='$(noinst_LTLIBRARIES)'; \
	locs=`for p in $$list; do echo $$p; done | \
	      sed 's|^[^/]*$$|.|; s|/[^/]*$$||; s|$$|/so_locations|' | \
	      sort -u`; \
	test -z "$$locs" || { \
	  echo rm -f $${locs}; \
	  rm -f $${locs}; \
	}

libmod_test_resolver.la: $(libmod_test_resolver_la_OBJECTS) $(libmod_test_resolver_la_DEPENDENCIES) $(EXTRA_libmod_test_resolver_la_DEPENDENCIES) 
	$(AM_V_CXXLD)$(libmod_test_resolver_la_LINK) $(am_libmod_test_resolver_la_rpath) $(libmod_test_resolver_la_OBJECTS) $(libmod_test_resolver_la_LIBADD) $(LIBS)

mod_test_resolver.la: $(mod_test_resolver_la_OBJECTS) $(mod_test_resolver_la_DEPENDENCIES) $(EXTRA_mod_test_resolver_la_DEPENDENCIES) 
