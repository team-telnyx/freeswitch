<?xml version="1.0" encoding="ISO-8859-1" ?>
<!-- Blind transfer test, B: answers, sends REFER to the target extension 1 s later, requires one
     final NOTIFY with the expected sipfrag, and ends on a BYE from FreeSWITCH or with its own
     BYE 4 s after the NOTIFY. -->
<scenario name="blind transfer referrer">
  <Global variables="expected_frag"/>

  <recv request="INVITE" crlf="true">
    <action>
      <ereg regexp="\n(m|Contact): *[^\r\n]*sip:([a-zA-Z0-9_.@:+-]+)" search_in="msg" check_it="true" assign_to="c0,c1,fs_contact"/>
      <ereg regexp="\n(f|From): *([^\r\n]+)" search_in="msg" check_it="true" assign_to="f0,f1,inv_from"/>
      <ereg regexp="\n(t|To): *([^\r\n]+)" search_in="msg" check_it="true" assign_to="t0,t1,inv_to"/>
    </action>
  </recv>

  <send>
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]B[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:referrer@[local_ip]:[local_port]>
      Allow: INVITE,ACK,CANCEL,BYE,REFER,NOTIFY,OPTIONS
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=B 1 1 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[local_ip_type] [local_ip]
      t=0 0
      m=audio [auto_media_port] RTP/AVP 0
      a=rtpmap:0 PCMU/8000
      a=sendrecv
    ]]>
  </send>

  <recv request="ACK"/>

  <pause milliseconds="1000"/>

  <send retrans="500">
    <![CDATA[

      REFER sip:[$fs_contact] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: [$inv_to];tag=[pid]B[call_number]
      To: [$inv_from]
      Call-ID: [call_id]
      CSeq: 101 REFER
      Contact: <sip:referrer@[local_ip]:[local_port]>
      Refer-To: <sip:7878780002@[local_ip]:5080>
      Max-Forwards: 70
      Content-Length: 0

    ]]>
  </send>

  <recv response="100" optional="true"/>
  <recv response="202"/>

  <!-- The first request after the 202 must be the final NOTIFY for the refer event, with the
       sipfrag the test passes in as expected_frag (-set expected_frag "SIP/2.0 403 Forbidden").
       A BYE first, a wrong Event, sipfrag or Subscription-State, or no NOTIFY in 10 s fails
       the call. -->
  <recv request="NOTIFY" timeout="10000">
    <action>
      <ereg regexp="message/sipfrag" search_in="hdr" header="Content-Type:" check_it="true" assign_to="ctype"/>
      <ereg regexp="terminated" search_in="hdr" header="Subscription-State:" check_it="true" assign_to="substate"/>
      <ereg regexp="^ *refer" search_in="hdr" header="Event:" check_it="true" assign_to="evt"/>
      <ereg regexp="SIP/2\.0 [0-9]{3} [A-Za-z ]+" search_in="body" check_it="true" assign_to="frag"/>
      <strcmp assign_to="frag_cmp" variable="frag" variable2="expected_frag"/>
      <test assign_to="frag_wrong" variable="frag_cmp" compare="not_equal" value="0"/>
    </action>
  </recv>

  <send>
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>
  <nop next="wrong_frag" test="frag_wrong"/>

  <!-- After the result: a BYE from FreeSWITCH, or B's own BYE 4 s later. A second
       NOTIFY is an unexpected message and fails the call. -->
  <recv request="BYE" timeout="4000" ontimeout="own_bye"/>
  <send next="end">
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <!-- Fails the call: this request never comes, and a timeout with no ontimeout
       label (or any other message) aborts the call. -->
  <label id="wrong_frag"/>
  <recv request="SIPFRAG_MISMATCH" timeout="100"/>

  <label id="own_bye"/>
  <send retrans="500">
    <![CDATA[

      BYE sip:[$fs_contact] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: [$inv_to];tag=[pid]B[call_number]
      To: [$inv_from]
      Call-ID: [call_id]
      CSeq: 102 BYE
      Max-Forwards: 70
      Content-Length: 0

    ]]>
  </send>
  <recv response="200"/>

  <label id="end"/>
  <Reference variables="c0,c1,f0,f1,t0,t1,ctype,substate,evt,frag_cmp"/>
</scenario>
